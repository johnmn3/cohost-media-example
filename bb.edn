{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p])

  setup {:doc "Fetch the two pinned dependencies as sibling checkouts (eve/, cohost.cljc/) and sync this app into the Eve tree at eve/capstone/cohost-media, where its boot program expects it."
         :task (let [eve-sha "f4a1c3ae97ee76f2651ce600a857675aa5c227ef"
                     cohost-sha "1db42b213585129c3f4384a30f0fa0bcfffa24ae"
                     ensure (fn [dir url sha]
                              (when-not (fs/exists? dir)
                                (p/shell "git" "clone" url dir))
                              (p/shell {:dir dir} "git" "fetch" "origin")
                              (p/shell {:dir dir} "git" "checkout" sha))]
                 (ensure "eve" "https://github.com/SeniorCareMarket/eve.git" eve-sha)
                 (ensure "cohost.cljc" "https://github.com/johnmn3/cohost.cljc.git" cohost-sha)
                 (doseq [e ["src" "page" "deps.edn" "package.json" "package-lock.json"]
                         :let [dest (fs/path "eve" "capstone" "cohost-media" e)]]
                   (when (fs/exists? dest)
                     (if (fs/directory? dest) (fs/delete-tree dest) (fs/delete dest)))
                   (if (fs/directory? e) (fs/copy-tree e dest) (fs/copy e dest)))
                 (println "cohost-media-example: eve and cohost.cljc at their pins; app synced into eve/capstone/cohost-media."))}

  demo {:doc "The demo: bb demo [--hosts bb,jvm,glj,node,browser] — sets up, then runs Eve's own bb cohost-media demo from the Eve checkout (the boot program composes its classpath from Eve's hosts.edn roots, this app's sources and maven deps, and cohost's src, found as the ../cohost.cljc sibling)."
        :depends [setup]
        :task (let [r (apply p/shell {:dir "eve" :continue true} "bb" "cohost-media" "demo" *command-line-args*)]
                (when-not (zero? (:exit r))
                  (println "the demo exited" (:exit r) "- its run report says why"))
                (System/exit (:exit r)))}

  ;; --- fleet syntax-formalization tasks (templates/bb-tasks.edn) ---
  ;; Adaptation for this repo: there is no test/ dir; the lint/format
  ;; paths are src and page/src everywhere the fleet template says
  ;; "src test". Tool pins: clj-kondo 2026.10.26, cljfmt 0.16.6,
  ;; carve v0.3.5 (bbin binaries on PATH), Splint 1.25.0 below.
  splint {:doc "Splint 1.25.0 shape/smell rules (defaults: src page/src)"
          :extra-deps {io.github.noahtheduke/splint {:mvn/version "1.25.0"}}
          :task (do (require 'noahtheduke.splint)
                    (apply (resolve 'noahtheduke.splint/-main)
                           (if (seq *command-line-args*)
                             *command-line-args*
                             ["src" "page/src"])))}

  lint-kondo {:doc "clj-kondo at the default fail level — warnings fail"
              :task (shell "clj-kondo --lint src page/src")}

  lint-splint {:doc "Splint shape/smell rules"
               :task (shell "bb splint")}

  carve-report {:doc "fail if any unused var is reported"
                :task (shell "carve --opts '{:paths [\"src\" \"page/src\"] :report {:format :text}}'")}

  fmt-check {:doc "cljfmt check — the fleet .cljfmt.edn is the rules"
             :task (shell "cljfmt check src page/src")}

  fmt {:doc "apply the fleet formatting"
       :task (shell "cljfmt fix src page/src")}

  lint {:doc "the whole gate"
        :depends [lint-kondo lint-splint carve-report fmt-check]}}}
